# Copy this file to .env and fill in your own OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Used only when you explicitly enable the optional audio lesson.
OPENAI_AUDIO_MODEL=gpt-audio
# Clear this value if your chosen text model does not accept reasoning_effort.
OPENAI_REASONING_EFFORT=none
